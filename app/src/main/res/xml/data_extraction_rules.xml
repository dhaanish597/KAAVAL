<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup rules. allowBackup is false, but AGP still wants valid targets for
  dataExtractionRules/fullBackupContent on API 31+.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
