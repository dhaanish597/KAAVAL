<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base theme. Compose draws everything; this only needs to set the window
         background so there is no white flash before the first frame. -->
    <style name="Theme.Vaakku" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:statusBarColor">@color/paper</item>
        <item name="android:navigationBarColor">@color/paper</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
