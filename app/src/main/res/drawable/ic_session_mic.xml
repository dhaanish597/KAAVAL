<?xml version="1.0" encoding="utf-8"?>
<!--
  The status-bar mark for the session notification.

  A microphone, because that is exactly what the notification is about: the mic
  is open. It states a fact about the hardware and grades nothing (CLAUDE.md #1,
  #9) — and a status-bar icon is rendered as a white-on-transparent silhouette
  and tinted by the system, so it carries no colour of ours in any case.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Mic body: a capsule from y=2 to y=14. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M12,2 C13.66,2 15,3.34 15,5 L15,11 C15,12.66 13.66,14 12,14 C10.34,14 9,12.66 9,11 L9,5 C9,3.34 10.34,2 12,2 Z" />

    <!-- Cradle: a half-circle under the body. -->
    <path
        android:fillColor="#00000000"
        android:pathData="M6,11 A6,6 0 0,0 18,11"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2" />

    <!-- Stem and foot. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M11,17 L13,17 L13,21 L11,21 Z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M8,21 L16,21 L16,22.5 L8,22.5 Z" />
</vector>
